rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection for registered accounts (admins, managers, clients)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Login activity & IP address logs
    match /login_logs/{logId} {
      allow read, write: if true;
    }

    // Bikes collection
    match /bikes/{bikeId} {
      allow read, write: if true;

      // Service subcollection
      match /services/{serviceId} {
        allow read, write: if true;
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow read, write: if true;
      }
    }
  }
}

